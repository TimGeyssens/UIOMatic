<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Version>6.0.0</Version>
    <Authors>UIOMatic</Authors>
    <Description>UIOMatic for Umbraco - A simple way to create custom sections in Umbraco</Description>
    <PackageTags>umbraco;uiomatic</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/UIOMatic/UIOMatic</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="13.0.0" />
    <PackageReference Include="Umbraco.Cms.Core" Version="13.0.0" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="13.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="NPoco" Version="5.7.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MediatR" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UIOMatic.Core\UIOMatic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App_Plugins\**" />
  </ItemGroup>

  <PropertyGroup>
    <AppPluginsFolder>$(MSBuildProjectDirectory)\App_Plugins</AppPluginsFolder>
    <SiteAppPluginsFolder>$(MSBuildProjectDirectory)\..\UIOMatic.Site\wwwroot\App_Plugins</SiteAppPluginsFolder>
  </PropertyGroup>

  <Target Name="CopyAppPlugins" AfterTargets="Build">
    <ItemGroup>
      <AppPluginsFiles Include="$(AppPluginsFolder)\**\*.*" />
    </ItemGroup>
    <Message Text="Copying App_Plugins to $(SiteAppPluginsFolder)" Importance="high" />
    <Copy SourceFiles="@(AppPluginsFiles)" DestinationFolder="$(SiteAppPluginsFolder)\%(RecursiveDir)" />
  </Target>

</Project>
