<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>UIOMatic.SPA</id>
        <version>7.0.0</version>
        <title>UIOMatic SPA</title>
        <authors>Tim Geyssens</authors>
        <owners>Tim Geyssens</owners>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <license type="expression">MIT</license>
        <projectUrl>https://github.com/TimGeyssens/UIOMatic</projectUrl>
        <description>UIOMatic Single Page Application package</description>
        <releaseNotes>Initial release of UIOMatic SPA v7</releaseNotes>
        <copyright>Copyright 2024</copyright>
        <tags>UIOMatic Umbraco SPA Vue</tags>
        <dependencies>
            <group targetFramework="net7.0">
                <dependency id="UIOMatic.Front.API" version="7.0.0" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="..\UIOMatic.SPA\dist\**\*.*" target="content\wwwroot\uiomatic-spa" />
        <file src="..\UIOMatic.SPA\package.json" target="content\wwwroot\uiomatic-spa" />
    </files>
</package> 